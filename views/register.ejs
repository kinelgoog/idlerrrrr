<%- include('header') %>
<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="glass-card p-5 col-md-4 text-center">
        <h2 class="mb-4 fw-bold text-success"><i class="fas fa-user-plus"></i> РЕГИСТРАЦИЯ</h2>
        <% if(error) { %> <div class="alert alert-danger"><%= error %></div> <% } %>
        <form action="/register" method="POST">
            <input type="text" name="username" class="form-control bg-dark text-white mb-3" placeholder="Придумайте Логин" required>
            <input type="password" name="password" class="form-control bg-dark text-white mb-3" placeholder="Придумайте Пароль" required>
            <button type="submit" class="btn btn-success w-100 btn-lg shadow">Создать</button>
        </form>
        <div class="mt-3"><a href="/login" class="text-muted small">Уже есть аккаунт?</a></div>
    </div>
</div>
<%- include('footer') %>
