<%- include('header') %>

<nav class="navbar navbar-expand navbar-dark bg-transparent py-3">
    <div class="container">
        <span class="navbar-brand fw-bold"><i class="fas fa-gamepad text-primary"></i> IDLER <span class="text-muted fs-6">PRO</span></span>
        <div class="d-flex align-items-center gap-3">
            <% if(user.isAdmin) { %> <a href="/admin" class="text-warning text-decoration-none small"><i class="fas fa-shield-alt"></i> ADMIN</a> <% } %>
            <a href="/logout" class="text-secondary"><i class="fas fa-sign-out-alt"></i></a>
        </div>
    </div>
</nav>

<div class="container pb-5">
    <div class="row g-4">
        <!-- LEFT COLUMN: Controls -->
        <div class="col-lg-4">
            <div class="glass-card p-4 mb-4 text-center">
                <div class="mb-2 text-uppercase text-muted small fw-bold">Текущий статус</div>
                <h2 class="mb-3 fw-bold" id="statusText"><%= bot.status %></h2>
                <div id="statusIndicator" class="status-dot mb-4 <%= bot.status === 'Running' ? 'status-running' : (bot.status === 'Stopped' ? 'status-stopped' : 'status-wait') %>"></div>
                
                <div class="d-grid gap-2">
                    <button class="btn btn-success btn-lg shadow-sm" onclick="doAction('start')"><i class="fas fa-play"></i> ЗАПУСК</button>
                    <button class="btn btn-danger shadow-sm" onclick="doAction('stop')"><i class="fas fa-stop"></i> ОСТАНОВКА</button>
                </div>
                <div class="mt-3 small text-muted">
                    <i class="fas fa-clock"></i> Сессия: <span id="uptime">00:00:00</span>
                </div>
            </div>

            <div class="glass-card p-4">
                <ul class="nav nav-pills mb-3 nav-fill" id="pills-tab" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#tab-main">Main</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-adv">Advanced</button>
                    </li>
                </ul>

                <form id="settingsForm">
                    <div class="tab-content" id="pills-tabContent">
                        <!-- MAIN SETTINGS -->
                        <div class="tab-pane fade show active" id="tab-main">
                            <div class="mb-3">
                                <label class="small text-muted">Steam Login</label>
                                <input type="text" id="login" class="form-control bg-dark text-white border-secondary" value="<%= user.steamLogin %>">
                            </div>
                            <div class="mb-3">
                                <label class="small text-muted">Steam Password</label>
                                <input type="password" id="pass" class="form-control bg-dark text-white border-secondary" value="<%= user.steamPassword %>">
                            </div>
                            <div class="mb-3">
                                <label class="small text-muted">Games (AppIDs)</label>
                                <div class="input-group">
                                    <input type="text" id="games" class="form-control bg-dark text-white border-secondary" value="<%= user.config.games.join(', ') %>">
                                    <button type="button" class="btn btn-outline-primary" onclick="fetchGames()"><i class="fas fa-list"></i></button>
                                </div>
                            </div>
                        </div>

                        <!-- ADVANCED SETTINGS -->
                        <div class="tab-pane fade" id="tab-adv">
                            <div class="mb-3">
                                <label class="small text-muted">Shared Secret (Auto 2FA)</label>
                                <input type="text" id="secret" class="form-control bg-dark text-white border-secondary" value="<%= user.sharedSecret %>" placeholder="Оставь пустым если нет">
                                <div class="form-text x-small">Код из SDA или телефона для авто-входа.</div>
                            </div>
                            <div class="mb-3">
                                <label class="small text-muted">Proxy (SOCKS5/HTTP)</label>
                                <input type="text" id="proxy" class="form-control bg-dark text-white border-secondary" value="<%= user.proxy %>" placeholder="http://user:pass@ip:port">
                            </div>
                            <div class="mb-3">
                                <label class="small text-muted">Custom Game Name</label>
                                <input type="text" id="customGame" class="form-control bg-dark text-white border-secondary" value="<%= user.config.customGame %>">
                            </div>
                            <div class="mb-3">
                                <label class="small text-muted">Auto Reply Message</label>
                                <input type="text" id="autoReply" class="form-control bg-dark text-white border-secondary" value="<%= user.config.autoReply %>">
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 mt-3">Сохранить настройки</button>
                </form>
            </div>
        </div>

        <!-- RIGHT COLUMN: Logs & Stats -->
        <div class="col-lg-8">
            <div class="glass-card p-0 overflow-hidden h-100 d-flex flex-column">
                <div class="p-3 border-bottom border-secondary bg-dark bg-opacity-50 d-flex justify-content-between">
                    <span class="fw-bold"><i class="fas fa-terminal me-2"></i> Live Console</span>
                    <button class="btn btn-sm btn-outline-secondary" onclick="clearLog()">Clear</button>
                </div>
                <div id="logWindow" class="log-console flex-grow-1">
                    <% bot.logs.forEach(l => { %>
                        <div class="log-entry log-<%= l.type %>">
                            <span class="text-muted">[<%= l.time %>]</span> <%= l.msg %>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 2FA Modal -->
<div class="modal fade" id="guardModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-card border-0">
            <div class="modal-body text-center p-4">
                <h4 class="mb-3"><i class="fas fa-mobile-alt text-primary"></i> Steam Guard</h4>
                <p class="text-muted mb-4">Введите код из приложения или Email</p>
                <input type="text" id="guardCodeInput" class="form-control form-control-lg text-center mb-3 bg-dark text-white" placeholder="XXXXX" maxlength="10">
                <button class="btn btn-primary w-100 py-2" onclick="sendGuard()">Подтвердить</button>
            </div>
        </div>
    </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
    const socket = io();
    const uid = "<%= user._id %>";
    socket.emit('join', uid);

    // Elements
    const logWin = document.getElementById('logWindow');
    const statusTxt = document.getElementById('statusText');
    const statusInd = document.getElementById('statusIndicator');
    const guardModal = new bootstrap.Modal(document.getElementById('guardModal'));
    let startTime = <%= bot.startTime ? bot.startTime : 'null' %>;

    // Uptime Counter
    setInterval(() => {
        if(startTime) {
            const diff = Math.floor((Date.now() - startTime) / 1000);
            const h = Math.floor(diff / 3600).toString().padStart(2, '0');
            const m = Math.floor((diff % 3600) / 60).toString().padStart(2, '0');
            const s = (diff % 60).toString().padStart(2, '0');
            document.getElementById('uptime').innerText = `${h}:${m}:${s}`;
        } else {
            document.getElementById('uptime').innerText = "00:00:00";
        }
    }, 1000);

    // Socket Events
    socket.on('new_log', (log) => {
        const div = document.createElement('div');
        div.className = `log-entry log-${log.type}`;
        div.innerHTML = `<span class="text-muted">[${log.time}]</span> ${log.msg}`;
        logWin.appendChild(div);
        logWin.scrollTop = logWin.scrollHeight;
    });

    socket.on('status_update', (st) => {
        statusTxt.innerText = st;
        statusInd.className = 'status-dot mb-4';
        if(st === 'Running') { statusInd.classList.add('status-running'); }
        else if(st === 'Stopped') { statusInd.classList.add('status-stopped'); startTime = null; }
        else { statusInd.classList.add('status-wait'); }
    });

    socket.on('uptime_start', (time) => { startTime = time; });

    socket.on('request_guard', () => { guardModal.show(); });

    // Actions
    async function doAction(action) {
        await fetch('/api/action', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ action })
        });
    }

    async function sendGuard() {
        const code = document.getElementById('guardCodeInput').value;
        await fetch('/api/action', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ action: 'guard', code })
        });
        guardModal.hide();
        document.getElementById('guardCodeInput').value = '';
    }

    document.getElementById('settingsForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = {
            steamLogin: document.getElementById('login').value,
            steamPassword: document.getElementById('pass').value,
            sharedSecret: document.getElementById('secret').value,
            proxy: document.getElementById('proxy').value,
            games: document.getElementById('games').value,
            customGame: document.getElementById('customGame').value,
            autoReply: document.getElementById('autoReply').value
        };
        await fetch('/api/update', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify(data)
        });
        const btn = e.target.querySelector('button[type="submit"]');
        const original = btn.innerText;
        btn.innerText = "Сохранено!";
        btn.classList.replace('btn-primary', 'btn-success');
        setTimeout(() => {
            btn.innerText = original;
            btn.classList.replace('btn-success', 'btn-primary');
        }, 2000);
    });

    async function fetchGames() {
        const btn = document.querySelector('.btn-outline-primary');
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
        const res = await fetch('/api/my-games');
        const data = await res.json();
        btn.innerHTML = '<i class="fas fa-list"></i>';
        
        if(data.games.length === 0) {
            alert("Сначала запустите бота, чтобы получить список игр!");
            return;
        }
        
        let ids = prompt("Найденные ID игр (скопируйте нужные):", data.games.join(', '));
        if(ids) document.getElementById('games').value = ids;
    }
    
    function clearLog() { logWin.innerHTML = ''; }
</script>
<%- include('footer') %>
