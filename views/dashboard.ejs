<!DOCTYPE html>
<html lang="ru" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ultimate Idler</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #121212; color: #fff; font-family: sans-serif; }
        .glass-card { background: rgba(255,255,255,0.05); padding: 20px; border-radius: 15px; border: 1px solid rgba(255,255,255,0.1); }
        .log-window { height: 300px; overflow-y: auto; background: #000; padding: 10px; font-family: monospace; font-size: 12px; color: #0f0; }
        .status-dot { width: 10px; height: 10px; display: inline-block; border-radius: 50%; background: gray; }
        .running { background: #0f0; box-shadow: 0 0 10px #0f0; }
    </style>
</head>
<body>

<nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container">
        <span class="navbar-brand">🤖 IDLER PRO</span>
        <a href="/logout" class="btn btn-outline-light btn-sm">Выход</a>
    </div>
</nav>

<div class="container">
    <div class="row">
        <!-- Настройки -->
        <div class="col-md-4">
            <div class="glass-card mb-3">
                <h5>Настройки</h5>
                <form id="settingsForm">
                    <div class="mb-2">
                        <label>Steam Login</label>
                        <input type="text" id="login" class="form-control bg-dark text-white" value="<%= user.steamLogin %>">
                    </div>
                    <div class="mb-2">
                        <label>Steam Password</label>
                        <input type="password" id="pass" class="form-control bg-dark text-white" value="<%= user.steamPassword %>">
                    </div>
                    <div class="mb-2">
                        <label>Shared Secret (для авто-входа)</label>
                        <input type="text" id="secret" class="form-control bg-dark text-white" value="<%= user.sharedSecret %>" placeholder="Необязательно">
                    </div>
                    <div class="mb-2">
                        <label>Games (AppIDs)</label>
                        <input type="text" id="games" class="form-control bg-dark text-white" value="<%= user.config.games.join(', ') %>">
                    </div>
                    <div class="mb-2">
                        <label>Proxy</label>
                        <input type="text" id="proxy" class="form-control bg-dark text-white" value="<%= user.proxy %>">
                    </div>
                    <button type="submit" class="btn btn-primary w-100 mt-2">Сохранить Настройки</button>
                </form>
            </div>
            
            <div class="glass-card text-center">
                <h5>Запуск</h5>
                <h3 id="statusText" class="my-3"><%= bot.status %></h3>
                <div id="statusInd" class="status-dot mb-3 <%= bot.status === 'Running' ? 'running' : '' %>"></div>
                
                <!-- НОВОЕ ПОЛЕ ДЛЯ КОДА -->
                <div class="mb-3">
                    <input type="text" id="preStartCode" class="form-control bg-dark text-white text-center" placeholder="Код Steam Guard (ввести перед стартом)">
                </div>

                <div class="d-grid gap-2">
                    <button class="btn btn-success" onclick="act('start')">ЗАПУСТИТЬ</button>
                    <button class="btn btn-danger" onclick="act('stop')">ОСТАНОВИТЬ</button>
                </div>
            </div>
        </div>

        <!-- Логи -->
        <div class="col-md-8">
            <div class="glass-card h-100">
                <h5>Логи</h5>
                <div id="logs" class="log-window">
                    <% bot.logs.forEach(l => { %>
                        <div>[<%= l.time %>] <%= l.msg %></div>
                    <% }) %>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Модалка (на всякий случай, если код не ввел) -->
<div class="modal fade" id="gModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content bg-dark">
        <div class="modal-body text-center">
            <h4>Введите код Steam Guard</h4>
            <p class="small text-muted">Вы не ввели код перед стартом. Введите сейчас:</p>
            <input id="gCode" class="form-control text-center my-3" placeholder="XXXXX">
            <button onclick="sendG()" class="btn btn-primary w-100">Отправить</button>
        </div>
    </div></div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const socket = io();
    socket.emit('join', "<%= user.id %>");

    const logDiv = document.getElementById('logs');
    const gModal = new bootstrap.Modal(document.getElementById('gModal'));

    socket.on('new_log', l => {
        const d = document.createElement('div');
        d.innerText = `[${l.time}] ${l.msg}`;
        logDiv.appendChild(d);
        logDiv.scrollTop = logDiv.scrollHeight;
    });

    socket.on('status_update', s => {
        document.getElementById('statusText').innerText = s;
        const ind = document.getElementById('statusInd');
        if(s === 'Running') ind.classList.add('running');
        else ind.classList.remove('running');
    });

    socket.on('request_guard', () => gModal.show());

    async function act(action) {
        // Берем код из нового поля
        const guardCode = document.getElementById('preStartCode').value;
        
        await fetch('/api/action', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({
                action,
                guardCode: guardCode // Отправляем код сразу
            })
        });
        
        // Очищаем поле, чтобы не мешалось
        if(action === 'start') document.getElementById('preStartCode').value = '';
    }

    async function sendG() {
        await fetch('/api/action', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({action:'guard', code: document.getElementById('gCode').value})
        });
        gModal.hide();
        document.getElementById('gCode').value = '';
    }

    document.getElementById('settingsForm').onsubmit = async (e) => {
        e.preventDefault();
        const data = {
            steamLogin: document.getElementById('login').value,
            steamPassword: document.getElementById('pass').value,
            sharedSecret: document.getElementById('secret').value,
            proxy: document.getElementById('proxy').value, 
            games: document.getElementById('games').value
        };
        await fetch('/api/update', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify(data)
        });
        alert('Настройки сохранены!');
    };
</script>
</body>
</html>
