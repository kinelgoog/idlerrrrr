<%- include('header') %>
<nav class="navbar navbar-dark bg-transparent py-3">
    <div class="container">
        <span class="navbar-brand fw-bold text-warning"><i class="fas fa-shield-alt"></i> ADMIN PANEL</span>
        <a href="/" class="btn btn-outline-light btn-sm">Назад в Dashboard</a>
    </div>
</nav>

<div class="container mt-4">
    <div class="glass-card p-4">
        <h4 class="mb-4">Пользователи системы</h4>
        <div class="table-responsive">
            <table class="table table-dark table-hover bg-transparent">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Status</th>
                        <th>Proxy</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(u => { %>
                        <tr>
                            <td><%= u.username %></td>
                            <td>
                                <% if(u.status === 'Running') { %>
                                    <span class="badge bg-success">Running</span>
                                <% } else if(u.status === 'Stopped') { %>
                                    <span class="badge bg-secondary">Stopped</span>
                                <% } else { %>
                                    <span class="badge bg-warning text-dark"><%= u.status %></span>
                                <% } %>
                            </td>
                            <td><%= u.proxy %></td>
                            <td>
                                <span class="text-muted small">Управление через БД</span>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>
<%- include('footer') %>
