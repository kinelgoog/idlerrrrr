<!DOCTYPE html>
<html lang="ru" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-dark text-white d-flex align-items-center justify-content-center vh-100">
    <div class="card bg-secondary p-4" style="width: 350px;">
        <h3 class="text-center mb-3">ВХОД</h3>
        <% if(error) { %> <div class="alert alert-danger p-2"><%= error %></div> <% } %>
        <form action="/login" method="POST">
            <input name="username" class="form-control mb-2" placeholder="Login" required>
            <input type="password" name="password" class="form-control mb-3" placeholder="Password" required>
            <button class="btn btn-primary w-100">Войти</button>
        </form>
        <div class="text-center mt-2"><a href="/register" class="text-light">Регистрация</a></div>
    </div>
</body>
</html>
