<!DOCTYPE html>
<html lang="ru" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#0d6efd">
    <title>Ultimate Idler Pro</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=JetBrains+Mono:wght@400;700&display=swap');
        
        body {
            background: radial-gradient(circle at top, #1a1f2c, #0e0e10);
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
        }
        .glass-card {
            background: rgba(30, 35, 50, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            transition: transform 0.2s;
        }
        .glass-card:hover { border-color: rgba(255,255,255,0.15); }
        
        .status-dot {
            height: 10px; width: 10px;
            background-color: #555;
            border-radius: 50%;
            display: inline-block;
            box-shadow: 0 0 10px currentColor;
        }
        .status-running { background-color: #00ff88; color: #00ff88; }
        .status-stopped { background-color: #ff4d4d; color: #ff4d4d; }
        .status-wait { background-color: #ffcc00; color: #ffcc00; }

        .log-console {
            background: #050505;
            border-radius: 12px;
            height: 350px;
            overflow-y: auto;
            padding: 15px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.85rem;
            border: 1px solid #333;
        }
        .log-entry { margin-bottom: 4px; border-left: 2px solid transparent; padding-left: 8px; }
        .log-info { border-color: #3498db; color: #aab; }
        .log-success { border-color: #2ecc71; color: #2ecc71; }
        .log-error { border-color: #e74c3c; color: #e74c3c; }
        .log-warning { border-color: #f1c40f; color: #f1c40f; }

        .nav-pills .nav-link.active {
            background-color: #3b82f6;
            box-shadow: 0 0 15px rgba(59, 130, 246, 0.5);
        }
        .nav-link { color: #aaa; }
        
        /* Mobile improvements */
        input, select { font-size: 16px !important; } 
    </style>
</head>
<body>
    <%- body %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
